---
import { appName } from "@/lib/shared";
import { defaultDescription, defaultOgImage, documentTitle, jsonLdText, ogImageSize } from "@/lib/seo";
import "@/styles/app.css";

interface Props {
  /** Page title without the site name; the site name is added when it fits. */
  title?: string;
  description?: string;
  /** Site-relative path of this page. Becomes the canonical URL; omit on pages that must not have one (404). */
  path?: string;
  ogType?: "website" | "article";
  /** Site-relative path or absolute URL. */
  ogImage?: string;
  /** ISO date the content last changed (article:modified_time). */
  modified?: string;
  noindex?: boolean;
  /** Structured data for the page, from lib/seo.ts. */
  jsonLd?: unknown;
}

const {
  title,
  description = defaultDescription,
  path,
  ogType = "website",
  ogImage = defaultOgImage,
  modified,
  noindex = false,
  jsonLd,
} = Astro.props;

const fullTitle = documentTitle(title);
const canonical = path ? new URL(path, Astro.site).href : undefined;
const image = new URL(ogImage, Astro.site).href;

/** Chromium prerenders likely links so a click shows the next page instantly. */
const speculationRules = {
  prerender: [{ where: { and: [{ href_matches: "/*" }, { not: { href_matches: ["/api/*", "/og/*", "/*.md"] } }] }, eagerness: "moderate" }],
  prefetch: [{ where: { and: [{ href_matches: "/*" }, { not: { href_matches: ["/api/*", "/og/*", "/*.md"] } }] }, eagerness: "eager" }],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={appName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={String(ogImageSize.width)} />
    <meta property="og:image:height" content={String(ogImageSize.height)} />
    {ogType === "article" && modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLdText(jsonLd)} />}
    <script is:inline type="speculationrules" set:html={JSON.stringify(speculationRules)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/geist-core.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/orbitron-core.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (() => {
        document.documentElement.setAttribute("data-js", "");
        let theme;
        try {
          theme = localStorage.getItem("theme");
        } catch {}
        theme ||= "dark";
        if (theme === "system")
          theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.classList.add(theme);
        document.documentElement.style.colorScheme = theme;
        // Entrance motion is on until scripts/site.ts takes over; if it never does, show everything.
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          document.documentElement.setAttribute("data-motion", "");
          setTimeout(() => {
            if (!document.documentElement.hasAttribute("data-motion-ready"))
              document.documentElement.removeAttribute("data-motion");
          }, 3000);
        }
      })();
    </script>
  </head>
  <body class="flex flex-col min-h-screen">
    <slot />
    <script is:inline>
      if (/Windows|Linux/i.test(navigator.userAgent))
        for (const key of document.querySelectorAll("[data-search-full] kbd:first-child"))
          key.textContent = "Ctrl";
    </script>
    <script>
      import "@/scripts/site";
    </script>
  </body>
</html>
