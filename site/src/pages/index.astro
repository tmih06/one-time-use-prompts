---
import { Home } from "@/components/home";
import Base from "@/layouts/base.astro";
import { getPrompts } from "@/lib/prompts";
import { appName } from "@/lib/shared";
import { defaultDescription, defaultOgImage, latest, pageGraph } from "@/lib/seo";

const prompts = getPrompts();
const title = `${appName}: prompts that run exactly once`;
const modified = latest(prompts);
const jsonLd = pageGraph({
  site: Astro.site!,
  kind: "home",
  path: "/",
  title,
  description: defaultDescription,
  image: defaultOgImage,
  crumbs: [{ name: appName, path: "/" }],
  modified,
  list: prompts,
});
---

<Base title={title} description={defaultDescription} path="/" jsonLd={jsonLd}>
  <Home prompts={prompts} />
</Base>
