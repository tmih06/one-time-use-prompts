---
import { Gallery } from "@/components/gallery";
import { PromptPage } from "@/components/prompt-page";
import Base from "@/layouts/base.astro";
import { getPrompts } from "@/lib/prompts";
import { browseCrumbs, browseMeta, defaultOgImage, pageGraph, promptCrumbs, promptPath } from "@/lib/seo";
import { getPageImageUrl } from "@/lib/shared";
import { docs, source } from "@/lib/source";
import { fetchTweets } from "@/lib/tweet";

/**
 * Prompt pages (/prompts/<phase>/<purpose>/<id>) show a single prompt. Every
 * shallower level — the library, a phase, a purpose — is a browse page and
 * renders as a gallery. Purposes have no source page, so their paths are added here.
 */
export function getStaticPaths() {
  const pages = source.getPages().map((page) => ({
    params: { slug: page.slugs.join("/") || undefined },
    props: { slugs: page.slugs },
  }));
  const purposes = [...new Set(getPrompts().map((p) => `${p.phase}/${p.purpose}`))].map((slug) => ({
    params: { slug },
    props: { slugs: slug.split("/") },
  }));
  return [...pages, ...purposes];
}

const { slugs } = Astro.props;
const isGallery = slugs.length < 3;
const page = source.getPage(slugs);

const doc = !isGallery && page ? docs.getPage(page.path)! : undefined;
if (doc) await doc.preload();
const tweets = doc ? await fetchTweets(doc.source) : [];

// Suggest the prompts closest to this one: same purpose first, then same phase.
const here = getPrompts().find((p) => p.splat === slugs.join("/"));
const rank = (p: { phase: string; purpose: string }) =>
  (p.phase === here?.phase ? 1 : 0) + (p.purpose === here?.purpose ? 1 : 0);
const related = getPrompts()
  .filter((p) => p.splat !== here?.splat)
  .sort((a, b) => rank(b) - rank(a))
  .slice(0, 3);

const pageImage = page ? getPageImageUrl(page).url : defaultOgImage;
const site = Astro.site!;

// Everything a crawler reads about this page, built in lib/seo.ts.
const browse = isGallery ? browseMeta(slugs[0], slugs[1]) : undefined;
const meta =
  isGallery && browse
    ? {
        title: browse.title,
        description: browse.description,
        path: slugs.length ? `/prompts/${slugs.join("/")}` : "/prompts",
        modified: browse.modified,
        jsonLd: pageGraph({
          site,
          kind: "browse",
          path: slugs.length ? `/prompts/${slugs.join("/")}` : "/prompts",
          title: browse.title,
          description: browse.description,
          image: pageImage,
          crumbs: browseCrumbs(slugs[0], slugs[1]),
          modified: browse.modified,
          list: browse.prompts,
        }),
      }
    : {
        title: here!.title,
        description: here!.description,
        path: promptPath(here!),
        modified: here!.updated,
        jsonLd: pageGraph({
          site,
          kind: "prompt",
          path: promptPath(here!),
          title: here!.title,
          description: here!.description,
          image: pageImage,
          crumbs: promptCrumbs(here!),
          modified: here!.updated,
          prompt: here!,
        }),
      };
---

<Base
  title={meta.title}
  description={meta.description}
  path={meta.path}
  ogImage={pageImage}
  ogType={isGallery ? "website" : "article"}
  modified={isGallery ? undefined : meta.modified}
  jsonLd={meta.jsonLd}
>
  {
    isGallery ? (
      <Gallery prompts={getPrompts()} phase={slugs[0]} purpose={slugs[1]} />
    ) : (
      <PromptPage
        path={page!.path}
        pathname={page!.url}
        markdownUrl={`${page!.url}.md`}
        tweets={tweets}
        related={related}
      />
    )
  }
</Base>
