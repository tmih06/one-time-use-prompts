# Copy to site/.env (gitignored). All optional: with none set, the site builds with no tracking.

# Browser: the project's public write key and ingestion host (US: us.i.posthog.com, EU: eu.i.posthog.com).
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Build only, SECRET: reads usage back for trending/analytics. Never prefix these with PUBLIC_.
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
# App host for the query API (US: us.posthog.com, EU: eu.posthog.com).
POSTHOG_APP_HOST=https://us.posthog.com

# Dev server only: show made-up usage numbers so the graphs can be seen before there is traffic.
# ANALYTICS_SAMPLE=1

# Build only, SECRET, optional: site visits from Cloudflare Web Analytics, shown on the home page.
# Token needs Account > Account Analytics > Read. The site tag is the `site_tag` field from the Web
# Analytics API (see ANALYTICS.md), not the token inside the beacon snippet.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WEB_ANALYTICS_SITE_TAG=
