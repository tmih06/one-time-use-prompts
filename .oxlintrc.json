{
  "$schema": "./node_modules/vite-plus/dist/oxlint-schema.json",
  "plugins": ["typescript", "react"],
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [
    "node_modules",
    "**/node_modules",
    "site/.output",
    "site/.source",
    "site/.tanstack",
    "site/content/docs",
    "site/src/routeTree.gen.ts",
    "bun.lock"
  ]
}
